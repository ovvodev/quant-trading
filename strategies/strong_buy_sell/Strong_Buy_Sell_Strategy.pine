//@version=6
strategy(title="Strong Buy/Sell Strategy Baseline", shorttitle="SBS_Strategy", overlay=true, calc_on_every_tick=true, max_labels_count=500, max_bars_back=5000, initial_capital=100000, default_qty_type=strategy.fixed, default_qty_value=1, margin_long=10, margin_short=10)

// ══════════════════════════════════════
// CONSTANTS
// ══════════════════════════════════════
GRP_MAIN     = "⚙️ Main Settings"
GRP_SIGNAL   = "📡 Signal Tuning"
GRP_FILTER   = "🔍 Filters"
GRP_STRATEGY = "📈 Strategy Rules"
GRP_RISK     = "💸 Risk & Exits"
GRP_VISUAL   = "🎨 Visual Settings"
GRP_COLORS   = "🎨 Colors"

// ══════════════════════════════════════
// INPUTS — Strategy Rules
// ══════════════════════════════════════
tradeDirectionInput = input.string("Long Only", "Trade Direction", options=["Long Only", "Short Only", "Both"], group=GRP_STRATEGY)

// ══════════════════════════════════════
// INPUTS — Risk & Exits
// ══════════════════════════════════════
slTypeInput = input.string("Fixed", "Stop Loss Type", options=["Fixed", "Swing"], group=GRP_RISK)
slPointsInput = input.float(50.0, "Fixed Stop Loss (Points)", minval=1.0, group=GRP_RISK, tooltip="Baseline Stop Loss applied to all entries if Fixed is selected.")

slSwingLookbackInput = input.int(20, "Swing Lookback (Bars)", minval=5, group=GRP_RISK, tooltip="How far back to look for swing highs/lows.")
slSwingMaxPointsInput = input.float(100.0, "Swing Max Risk (Points)", minval=1.0, group=GRP_RISK)
slSwingMinPointsInput = input.float(15.0, "Swing Min Risk (Points)", minval=1.0, group=GRP_RISK)

riskUsdPerTradeInput = input.float(100.0, "Risk Per Trade (USD)", minval=10.0, group=GRP_RISK)
minContractsInput = input.int(1, "Min Contracts", minval=1, group=GRP_RISK)
maxContractsInput = input.int(5, "Max Contracts", minval=1, group=GRP_RISK)

// Strong Signal Exit Logic
tpStrongRInput = input.float(2.0, "Strong Target (R-Multiple)", minval=0.1, step=0.1, group=GRP_RISK, tooltip="Take profit distance as a multiple of Stop Loss. 2.0R with 50pt SL = 100pt TP.")
beStrongRInput = input.float(1.0, "Strong Break-Even (R-Multiple)", minval=0.1, step=0.1, group=GRP_RISK, tooltip="Profit needed to move stop to Break-Even. 1.0R with 50pt SL = 50pt profit to trigger BE.")

// Pullback Signal Exit Logic
tpPullRInput = input.float(1.5, "Pullback Target (R-Multiple)", minval=0.1, step=0.1, group=GRP_RISK, tooltip="Take profit distance as a multiple of Stop Loss.")
bePullRInput = input.float(0.5, "Pullback Break-Even (R-Multiple)", minval=0.1, step=0.1, group=GRP_RISK, tooltip="Profit needed to move stop to Break-Even.")

// Trailing Logic
useTrailingInput = input.bool(false, "Enable Trailing Stop (After BE)", group=GRP_RISK, tooltip="If true, trails the stop loss after Break-Even is achieved.")
trailOffsetPointsInput = input.float(25.0, "Trailing Offset (Points)", minval=1.0, group=GRP_RISK, tooltip="Distance behind the high/low to trail the stop.")

// ══════════════════════════════════════
// INPUTS — Main Settings
// ══════════════════════════════════════
sensitivityInput = input.float(2.5, "Trend Sensitivity", minval=0.5, maxval=8.0, step=0.1, group=GRP_MAIN)
atrPeriodInput   = input.int(21, "ATR Period", minval=5, maxval=100, group=GRP_MAIN)
sourceInput      = input.source(close, "Source", group=GRP_MAIN)
presetInput      = input.string("Balanced", "Preset", options=["Conservative", "Balanced", "Aggressive", "Scalping"], group=GRP_MAIN)

// ══════════════════════════════════════
// INPUTS — Signal Tuning
// ══════════════════════════════════════
minScoreInput       = input.int(55, "Min Signal Score (0-100)", minval=10, maxval=95, step=5, group=GRP_SIGNAL)
showStrongOnlyInput = input.bool(true, "Strong Signals Only (75+)", group=GRP_SIGNAL)
showPullbackInput   = input.bool(true, "Show Pullback Signals", group=GRP_SIGNAL)
pullbackSensInput   = input.int(8, "Pullback Sensitivity", minval=3, maxval=20, group=GRP_SIGNAL)

// ══════════════════════════════════════
// INPUTS — Filters
// ══════════════════════════════════════
useVolFilterInput      = input.bool(false, "Volume Filter", group=GRP_FILTER)
useAdxFilterInput      = input.bool(true, "ADX Trend Strength Filter", group=GRP_FILTER)
useMomentumFilterInput = input.bool(true, "Momentum Filter", group=GRP_FILTER)

// ══════════════════════════════════════
// INPUTS — Visual & Colors
// ══════════════════════════════════════
showSignalsInput = input.bool(true, "Show Buy/Sell Labels", group=GRP_VISUAL)
bullColorInput = input.color(#089981, "Bull", inline="colors1", group=GRP_COLORS)
bearColorInput = input.color(#FF5252, "Bear", inline="colors1", group=GRP_COLORS)
LABEL_TEXT = #FFFFFF

// ══════════════════════════════════════
// FUNCTIONS
// ══════════════════════════════════════
safeDiv(float num, float den, float fallback = 0.0) =>
    den != 0 and not na(num) and not na(den) ? num / den : fallback

ehlersSS(float src, int period) =>
    float a1 = math.exp(-math.sqrt(2) * math.pi / math.max(period, 2))
    float b1 = 2.0 * a1 * math.cos(math.sqrt(2) * math.pi / math.max(period, 2))
    float c2 = b1
    float c3 = -a1 * a1
    float c1 = 1.0 - c2 - c3
    var float ss = na
    ss := bar_index < 3 ? nz(src, 0.0) : c1 * (src + nz(src[1], src)) * 0.5 + c2 * nz(ss[1], src) + c3 * nz(ss[2], src)
    ss

adaptiveAtr(int period) =>
    float rawAtr = nz(ta.atr(period), 0.0)
    float direction = math.abs(close - close[period])
    float volatility = math.sum(math.abs(close - close[1]), period)
    float er = safeDiv(direction, volatility, 0.5)
    float fastSc = 2.0 / 3.0
    float slowSc = 2.0 / 31.0
    float sc = math.pow(er * (fastSc - slowSc) + slowSc, 2)
    var float aAtr = na
    aAtr := na(aAtr[1]) ? rawAtr : aAtr[1] + sc * (rawAtr - aAtr[1])
    aAtr

avte(float src, float factor, int atrLen) =>
    float filteredPrice = ehlersSS(src, math.max(math.round(atrLen / 2), 3))
    float aAtr = adaptiveAtr(atrLen)
    float upperBand = filteredPrice + factor * aAtr
    float lowerBand = filteredPrice - factor * aAtr

    var float upper = na
    var float lower = na
    var int dir = 1
    var float trendLine = na

    lower := nz(lower[1], lowerBand)
    upper := nz(upper[1], upperBand)

    lower := lowerBand > lower or close[1] < lower ? lowerBand : lower
    upper := upperBand < upper or close[1] > upper ? upperBand : upper

    if close > upper
        dir := 1
    else if close < lower
        dir := -1

    trendLine := dir == 1 ? lower : upper
    [trendLine, dir, filteredPrice, aAtr]

// ══════════════════════════════════════
// PRESET APPLICATION
// ══════════════════════════════════════
float effectiveSensitivity = switch presetInput
    "Conservative" => sensitivityInput * 1.4
    "Aggressive"   => sensitivityInput * 0.7
    "Scalping"     => sensitivityInput * 0.5
    => sensitivityInput

int effectiveAtr = switch presetInput
    "Conservative" => math.round(atrPeriodInput * 1.3)
    "Aggressive"   => math.round(atrPeriodInput * 0.8)
    "Scalping"     => math.round(atrPeriodInput * 0.6)
    => atrPeriodInput

int effectiveMinScore = switch presetInput
    "Conservative" => math.max(minScoreInput, 70)
    "Aggressive"   => math.min(minScoreInput, 45)
    "Scalping"     => math.min(minScoreInput, 40)
    => minScoreInput

// ══════════════════════════════════════
// SHARED INDICATORS
// ══════════════════════════════════════
float ema50  = nz(ta.ema(close, 50), close)
float ema200 = nz(ta.ema(close, 200), close)

// MACD
float macdFastLine = nz(ta.ema(close, 12), close)
float macdSlowLine = nz(ta.ema(close, 26), close)
float macdLine     = macdFastLine - macdSlowLine
float macdSignal   = nz(ta.ema(macdLine, 9), 0.0)
float macdHist     = macdLine - macdSignal

// ADX
[diP, diM, adxVal] = ta.dmi(14, 14)
float adxSafe = nz(adxVal, 0.0)

// Volume
bool hasVolume   = nz(volume, 0) > 0
float volSma20   = hasVolume ? nz(ta.sma(volume, 20), 0.0) : 0.0
float volEmaFast = hasVolume ? nz(ta.ema(volume, 10), 0.0) : 0.0
float volEmaSlow = hasVolume ? nz(ta.ema(volume, 25), 0.0) : 0.0

// RSI
float rsi14 = nz(ta.rsi(close, 14), 50.0)

// ══════════════════════════════════════
// CALCULATIONS — Core Engine
// ══════════════════════════════════════
int WARMUP_BARS = math.max(effectiveAtr * 3, 200)
bool isWarmedUp = bar_index >= WARMUP_BARS

[avteLine, avteDir, filteredSrc, aAtr] = avte(sourceInput, effectiveSensitivity, effectiveAtr)

int prevDir = nz(avteDir[1], avteDir)
bool trendFlipBull = avteDir == 1 and prevDir == -1
bool trendFlipBear = avteDir == -1 and prevDir == 1

// ══════════════════════════════════════
// MOMENTUM SCORE (0-100)
// ══════════════════════════════════════
calcMomentumScore() =>
    float score = 50.0
    bool emaAlignBull = close > ema50 and ema50 > ema200
    bool emaAlignBear = close < ema50 and ema50 < ema200
    score += emaAlignBull ? 15.0 : emaAlignBear ? -15.0 : 0.0
    score += (rsi14 > 50 and rsi14 < 70) ? 10.0 : (rsi14 <= 50 and rsi14 > 30) ? -10.0 : 0.0
    score += (macdHist > 0 and macdHist > macdHist[1]) ? 12.0 : (macdHist < 0 and macdHist < macdHist[1]) ? -12.0 : 0.0
    bool volAbove = hasVolume and volume > volSma20 * 1.2
    bool volBelow = hasVolume and volume < volSma20 * 0.8
    float priceChg = close - close[1]
    score += volAbove and priceChg > 0 ? 8.0 : volAbove and priceChg < 0 ? -8.0 : volBelow ? (priceChg > 0 ? -4.0 : 4.0) : 0.0
    bool adxTrending = adxSafe > 20
    score += adxTrending and diP > diM ? 8.0 : adxTrending and diM > diP ? -8.0 : 0.0
    math.max(0.0, math.min(100.0, score))

float mScore = calcMomentumScore()

// ══════════════════════════════════════
// FILTERS
// ══════════════════════════════════════
bool volConfirm = hasVolume ? volEmaFast > volEmaSlow : true
bool adxConfirm = adxSafe > 20.0
bool momentumBull = macdHist > 0 and macdHist > macdHist[1]
bool momentumBear = macdHist < 0 and macdHist < macdHist[1]

bool volFilterOk = useVolFilterInput ? volConfirm : true
bool adxFilterOk = useAdxFilterInput ? adxConfirm : true
bool bullMomOk   = useMomentumFilterInput ? momentumBull : true
bool bearMomOk   = useMomentumFilterInput ? momentumBear : true

bool bullFiltersPass = volFilterOk and adxFilterOk and bullMomOk
bool bearFiltersPass = volFilterOk and adxFilterOk and bearMomOk

// ══════════════════════════════════════
// SIGNAL LOGIC (Strong)
// ══════════════════════════════════════
int minScore = showStrongOnlyInput ? math.max(effectiveMinScore, 75) : effectiveMinScore
int sellThreshold = 100 - minScore

bool rawBuy = trendFlipBull and mScore >= minScore and bullFiltersPass
bool rawSell = trendFlipBear and mScore <= sellThreshold and bearFiltersPass

bool confirmedBuy = rawBuy and isWarmedUp 
bool confirmedSell = rawSell and isWarmedUp

bool isStrongBuy  = confirmedBuy and mScore >= 75
bool isStrongSell = confirmedSell and mScore <= 25

// ══════════════════════════════════════
// PULLBACK SIGNALS
// ══════════════════════════════════════
float pullRsi = nz(ta.rsi(close, pullbackSensInput), 50.0)
float pullEma = nz(ta.ema(close, pullbackSensInput * 3), close)

bool pullbackBuyRaw = showPullbackInput and avteDir == 1 and not trendFlipBull and close <= pullEma and pullRsi < 35 and pullRsi > pullRsi[1]
bool pullbackSellRaw = showPullbackInput and avteDir == -1 and not trendFlipBear and close >= pullEma and pullRsi > 65 and pullRsi < pullRsi[1]

bool pullbackBuy = pullbackBuyRaw and bullFiltersPass and isWarmedUp
bool pullbackSell = pullbackSellRaw and bearFiltersPass and isWarmedUp

// ══════════════════════════════════════
// LABELS (Visual Baseline)
// ══════════════════════════════════════
plotshape(showSignalsInput and confirmedBuy and isStrongBuy ? low : na,"Strong Buy",shape.labelup,location.belowbar,bullColorInput,text = "Strong\nBuy",textcolor = LABEL_TEXT,size = size.tiny)
plotshape(showSignalsInput and confirmedSell and isStrongSell ? high : na,"Strong Sell",shape.labeldown,location.abovebar,bearColorInput,text = "Strong\nSell",textcolor = LABEL_TEXT,size = size.tiny)
plotshape(showSignalsInput and pullbackBuy ? low : na,"Pullback Buy",shape.triangleup,location.belowbar,bullColorInput,size = size.tiny)
plotshape(showSignalsInput and pullbackSell ? high : na,"Pullback Sell",shape.triangledown,location.abovebar,bearColorInput,size = size.tiny)

// ══════════════════════════════════════
// STRATEGY EXECUTION & EXITS - FIXED
// ══════════════════════════════════════

bool allowLong  = tradeDirectionInput == "Long Only" or tradeDirectionInput == "Both"
bool allowShort = tradeDirectionInput == "Short Only" or tradeDirectionInput == "Both"

// Persistent trade state
var string activeTradeType = ""
var float stopLevel = na
var float takeProfitLevel = na
var bool isBreakEven = false
var float activeSlDist = na

// Detect actual position changes
bool newLongPosition  = strategy.position_size > 0 and strategy.position_size[1] <= 0
bool newShortPosition = strategy.position_size < 0 and strategy.position_size[1] >= 0
bool positionClosed   = strategy.position_size == 0 and strategy.position_size[1] != 0

// Reset ONLY when a position has actually closed
if positionClosed
    activeTradeType := ""
    stopLevel := na
    takeProfitLevel := na
    isBreakEven := false
    activeSlDist := na

// ══════════════════════════════════════
// ENTRY SIGNALS
// ══════════════════════════════════════

float calcSlDistance(bool isLongTrade) =>
    float dist = slPointsInput
    if slTypeInput == "Swing"
        if isLongTrade
            float swingLow = ta.lowest(low, slSwingLookbackInput)
            dist := close - swingLow
        else
            float swingHigh = ta.highest(high, slSwingLookbackInput)
            dist := swingHigh - close
        dist := math.max(slSwingMinPointsInput, math.min(slSwingMaxPointsInput, dist))
    dist

var float pendingSlDist = na

// Only enter when no position exists
if strategy.position_size == 0
    if isStrongBuy and allowLong
        pendingSlDist := calcSlDistance(true)
        float riskPerContract = pendingSlDist * syminfo.pointvalue
        float finalQty = math.max(minContractsInput, math.min(maxContractsInput, math.floor(riskUsdPerTradeInput / riskPerContract)))
        activeTradeType := "STRONG"
        isBreakEven := false
        strategy.entry("STRONG_LONG", strategy.long, qty=finalQty, comment="STRONG_LONG")
    else if isStrongSell and allowShort
        pendingSlDist := calcSlDistance(false)
        float riskPerContract = pendingSlDist * syminfo.pointvalue
        float finalQty = math.max(minContractsInput, math.min(maxContractsInput, math.floor(riskUsdPerTradeInput / riskPerContract)))
        activeTradeType := "STRONG"
        isBreakEven := false
        strategy.entry("STRONG_SHORT", strategy.short, qty=finalQty, comment="STRONG_SHORT")
    else if pullbackBuy and allowLong
        pendingSlDist := calcSlDistance(true)
        float riskPerContract = pendingSlDist * syminfo.pointvalue
        float finalQty = math.max(minContractsInput, math.min(maxContractsInput, math.floor(riskUsdPerTradeInput / riskPerContract)))
        activeTradeType := "PULLBACK"
        isBreakEven := false
        strategy.entry("PULLBACK_LONG", strategy.long, qty=finalQty, comment="PULLBACK_LONG")
    else if pullbackSell and allowShort
        pendingSlDist := calcSlDistance(false)
        float riskPerContract = pendingSlDist * syminfo.pointvalue
        float finalQty = math.max(minContractsInput, math.min(maxContractsInput, math.floor(riskUsdPerTradeInput / riskPerContract)))
        activeTradeType := "PULLBACK"
        isBreakEven := false
        strategy.entry("PULLBACK_SHORT", strategy.short, qty=finalQty, comment="PULLBACK_SHORT")

// ══════════════════════════════════════
// INITIALIZE RISK FROM ACTUAL FILL
// ══════════════════════════════════════

if newLongPosition
    float entryPrice = strategy.position_avg_price
    float targetR = activeTradeType == "STRONG" ? tpStrongRInput : tpPullRInput
    activeSlDist := nz(pendingSlDist, slPointsInput)
    stopLevel := entryPrice - activeSlDist
    takeProfitLevel := entryPrice + activeSlDist * targetR
    isBreakEven := false

if newShortPosition
    float entryPrice = strategy.position_avg_price
    float targetR = activeTradeType == "STRONG" ? tpStrongRInput : tpPullRInput
    activeSlDist := nz(pendingSlDist, slPointsInput)
    stopLevel := entryPrice + activeSlDist
    takeProfitLevel := entryPrice - activeSlDist * targetR
    isBreakEven := false

// ══════════════════════════════════════
// LONG POSITION MANAGEMENT
// ══════════════════════════════════════

if strategy.position_size > 0
    float entryPrice = strategy.position_avg_price
    float beR = activeTradeType == "STRONG" ? beStrongRInput : bePullRInput
    float beTrigger = entryPrice + activeSlDist * beR

    // Move to break-even
    if high >= beTrigger and not isBreakEven
        stopLevel := entryPrice
        isBreakEven := true

    // Optional trailing AFTER BE
    if useTrailingInput and isBreakEven
        float trailCandidate = high - trailOffsetPointsInput
        stopLevel := na(stopLevel) ? trailCandidate : math.max(stopLevel, trailCandidate)

    strategy.exit("LONG_EXIT", from_entry=strategy.opentrades.entry_id(0), stop=stopLevel, limit=takeProfitLevel)

// ══════════════════════════════════════
// SHORT POSITION MANAGEMENT
// ══════════════════════════════════════

if strategy.position_size < 0
    float entryPrice = strategy.position_avg_price
    float beR = activeTradeType == "STRONG" ? beStrongRInput : bePullRInput
    float beTrigger = entryPrice - activeSlDist * beR

    // Move to break-even
    if low <= beTrigger and not isBreakEven
        stopLevel := entryPrice
        isBreakEven := true

    // Optional trailing AFTER BE
    if useTrailingInput and isBreakEven
        float trailCandidate = low + trailOffsetPointsInput
        stopLevel := na(stopLevel) ? trailCandidate : math.min(stopLevel, trailCandidate)

    strategy.exit("SHORT_EXIT", from_entry=strategy.opentrades.entry_id(0), stop=stopLevel, limit=takeProfitLevel)


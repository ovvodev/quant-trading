i_sigKzFilter  = input.bool(false, "Filter: Killzones Only", group=grp_sig, tooltip="Only trigger signals during enabled session killzones")
i_sigHtfFilter = input.bool(false, "Filter: HTF Bias Confluence", group=grp_sig, tooltip="Only Long if 15m/1H Swing is Bullish, only Short if Bearish")

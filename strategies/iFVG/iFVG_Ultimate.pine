// ═══════════════════════════════════════════════════════════════════════════════
// iFVG Ultimate — Institutional-Grade Multi-Module Indicator
// Pine Script v6 | TradingView
// ═══════════════════════════════════════════════════════════════════════════════
//@version=6
indicator("iFVG Ultimate", shorttitle="iFVG Ultimate", overlay=true,
     max_boxes_count=500, max_labels_count=500, max_lines_count=500, max_bars_back=500)


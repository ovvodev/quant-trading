// Version 2.1: FVG tracking decoupled from macro display filter, broken-vs-swept liquidity,
//              macro change detection for adjacent windows, sweep / iFVG alerts

//@version=6
indicator("Macro + iFVG + Liquidity [HERMAN] v2", shorttitle = "Macro + iFVG + Liquidity[HERMAN] v2", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// =============================================================================
// 1. INPUTS (Exact 1:1 Match with Herman Official Reference Settings)
// =============================================================================

// --- FVG ---
grp_fvg        = "FVG"
show_fvg       = input.bool(true, "Mark FVG", group=grp_fvg)
fvg_size_unit  = input.string("Ticks", "FVG Size Unit", options=["Ticks", "Points"], group=grp_fvg, tooltip="Unit used by the minimum FVG and iFVG size filters.")
min_fvg_size   = input.float(0.0, "Minimum FVG size", minval=0.0, step=0.5, group=grp_fvg, tooltip="Minimum gap size in the selected unit. Set to 0 to detect all standard 3-bar imbalances.")
col_bull_fvg   = input.color(color.new(#089981, 85), "FVG Bullish Color", group=grp_fvg)
col_bear_fvg   = input.color(color.new(#f23645, 85), "FVG Bearish Color", group=grp_fvg)
fvg_macro_only = input.bool(true, "Show Only FVG Created in Macro Times", group=grp_fvg)
fvg_borders    = input.bool(true, "Borders", group=grp_fvg)
fvg_bg         = input.bool(true, "Background", group=grp_fvg)
fvg_extend     = input.int(1, "Extend boxes", minval=0, maxval=50, group=grp_fvg, tooltip="Number of bars forward to extend static FVG boxes.")
fvg_no_labels  = input.bool(true, "No labels?", group=grp_fvg)

// --- IFVG ---
grp_ifvg        = "IFVG"
show_ifvg       = input.bool(true, "Mark iFVG", group=grp_ifvg)
min_ifvg_size   = input.float(0.0, "Minimum iFVG size", minval=0.0, step=0.5, group=grp_ifvg, tooltip="Minimum inverted gap size in the selected FVG size unit.")
col_bull_ifvg   = input.color(color.new(#089981, 85), "IFVG Bullish Color", group=grp_ifvg)
col_bear_ifvg   = input.color(color.new(#f23645, 85), "IFVG Bearish Color", group=grp_ifvg)
ifvg_macro_only = input.bool(true, "Show Only iFVG Created in Macro Times", group=grp_ifvg)
ifvg_borders    = input.bool(true, "Borders", group=grp_ifvg)
ifvg_bg         = input.bool(true, "Background", group=grp_ifvg)
ifvg_extend     = input.int(1, "Extend boxes", minval=0, maxval=50, group=grp_ifvg, tooltip="Number of bars forward to extend static iFVG boxes.")
ifvg_no_labels  = input.bool(true, "No labels?", group=grp_ifvg)

// --- MACRO TIMES ---
grp_macro         = "MACRO TIMES"
enable_all_macros = input.bool(true, "Enable All Macro Times", group=grp_macro)

mac_0050 = input.bool(true, "00:50–01:10", group=grp_macro)
mac_0150 = input.bool(true, "01:50–02:10", group=grp_macro)
mac_0250 = input.bool(true, "02:50–03:10", group=grp_macro)
mac_0350 = input.bool(true, "03:50–04:10", group=grp_macro)
mac_0450 = input.bool(true, "04:50–05:10", group=grp_macro)
mac_0550 = input.bool(true, "05:50–06:10", group=grp_macro)
mac_0650 = input.bool(true, "06:50–07:10", group=grp_macro)
mac_0750 = input.bool(true, "07:50–08:10", group=grp_macro)
mac_0850 = input.bool(true, "08:50–09:10", group=grp_macro)
mac_0950 = input.bool(true, "09:50–10:10", group=grp_macro)
mac_1050 = input.bool(true, "10:50–11:10", group=grp_macro)
mac_1150 = input.bool(true, "11:50–12:10", group=grp_macro)
mac_1250 = input.bool(true, "12:50–13:10", group=grp_macro)
mac_1350 = input.bool(true, "13:50–14:10", group=grp_macro)
mac_1450 = input.bool(true, "14:50–15:10", group=grp_macro)
mac_1515 = input.bool(true, "15:15–15:45", group=grp_macro)
mac_1550 = input.bool(true, "15:50–16:10", group=grp_macro)
mac_1650 = input.bool(true, "16:50–17:10", group=grp_macro)
mac_1750 = input.bool(true, "17:50–18:10", group=grp_macro)
mac_1850 = input.bool(true, "18:50–19:10", group=grp_macro)
mac_1950 = input.bool(true, "19:50–20:10", group=grp_macro)
mac_2050 = input.bool(true, "20:50–21:10", group=grp_macro)
mac_2150 = input.bool(true, "21:50–22:10", group=grp_macro)
mac_2250 = input.bool(true, "22:50–23:10", group=grp_macro)
mac_2350 = input.bool(true, "23:50–00:10", group=grp_macro)

mac_line_col = input.color(#363a45, "Macro Time Line Color", group=grp_macro)
mac_lbl_bg   = input.color(color.white, "Macro Time Label Color", group=grp_macro)
mac_lbl_size = input.string("Small", "Macro Time Label Size", options=["Tiny", "Small", "Normal"], group=grp_macro)
use_auto_tz  = input.bool(true, "Auto NY Exchange Timezone", group=grp_macro, tooltip="Automatically anchors macro times to America/New_York exchange time, absorbing DST transitions seamlessly.")
mac_tz       = input.float(1.0, "Manual Time Zone Offset (hours)", step=0.5, group=grp_macro, tooltip="Used when Auto NY Exchange Timezone is disabled. Offset added to UTC-5 EST. 1.0 = EDT, 0.0 = EST.")
mac_line_len = input.float(0.0002, "Vertical Line Length (relative to price)", step=0.0001, group=grp_macro, tooltip="Fraction of price used to scale the downward bracket legs.")

// --- LIQUIDITY ---
grp_liq            = "LIQUIDITY"
en_liq             = input.bool(true, "Enable Liquidity Levels", group=grp_liq)
liq_mode           = input.string("Conservative", "Liquidity Levels Detection", options=["Aggressive", "Balanced", "Conservative"], group=grp_liq)
max_liq_lines      = input.int(50, "Max Liquidity Lines", minval=1, maxval=100, group=grp_liq)
max_swept_lines    = input.int(50, "Max Swept Lines", minval=1, maxval=100, group=grp_liq)
liq_extend_current = input.bool(true, "Extend to Current Bar", group=grp_liq)
show_sweep_markers = input.bool(true, "Show Sweep Arrow Markers", group=grp_liq, tooltip="Plots directional sweep arrows at the candle that swept and reclaimed liquidity.")
col_bull_liq       = input.color(#089981, "Bullish Liquidity", group=grp_liq)
col_bull_sweep     = input.color(color.new(#089981, 20), "Sweep", inline="bull_sweep_in", group=grp_liq)
col_bear_liq       = input.color(#f23645, "Bearish Liquidity", group=grp_liq)
col_bear_sweep     = input.color(color.new(#f23645, 20), "Sweep", inline="bear_sweep_in", group=grp_liq)
col_bull_swept     = input.color(color.new(#089981, 70), "Bullish Swept", group=grp_liq)
col_bear_swept     = input.color(color.new(#f23645, 70), "Bearish Swept", group=grp_liq)

// --- CANDLE COLORS ---
grp_candle      = "CANDLE COLORS"
col_bull_candle = input.color(color.white, "Bullish Candle Color", group=grp_candle)
col_bear_candle = input.color(color.white, "Bearish Candle Color", group=grp_candle)

color bar_col = close > open ? col_bull_candle : col_bear_candle
barcolor(bar_col == color.new(color.white, 100) ? na : bar_col)

lbl_sz = mac_lbl_size == "Tiny" ? size.tiny : mac_lbl_size == "Small" ? size.small : size.normal

// =============================================================================
// 2. MACRO TIMES LOGIC (NEW YORK ALIGNED WITH AUTO DST RESOLUTION)
// =============================================================================

int bar_m_of_day = 0
if use_auto_tz
    // Native New York time absorbs DST transitions automatically
    int ny_h = hour(time, "America/New_York")
    int ny_m = minute(time, "America/New_York")
    bar_m_of_day := ny_h * 60 + ny_m
else
    int utc_h = hour(time, "GMT")
    int utc_m = minute(time, "GMT")
    int total_offset_mins = math.round((-5.0 + mac_tz) * 60)
    bar_m_of_day := (utc_h * 60 + utc_m + total_offset_mins) % 1440
    if bar_m_of_day < 0
        bar_m_of_day += 1440

f_check_macro(int start_m, int end_m, bool is_enabled) =>
    bool active = false
    if enable_all_macros and is_enabled
        if start_m <= end_m
            active := (bar_m_of_day >= start_m) and (bar_m_of_day < end_m)
        else
            active := (bar_m_of_day >= start_m) or (bar_m_of_day < end_m)
    active

bool in_macro_now = false
string active_macro_name = ""

if f_check_macro(50, 70, mac_0050)
    in_macro_now := true
    active_macro_name := "00:50-01:10"
else if f_check_macro(110, 130, mac_0150)
    in_macro_now := true
    active_macro_name := "01:50-02:10"
else if f_check_macro(170, 190, mac_0250)
    in_macro_now := true
    active_macro_name := "02:50-03:10"
else if f_check_macro(230, 250, mac_0350)
    in_macro_now := true
    active_macro_name := "03:50-04:10"
else if f_check_macro(290, 310, mac_0450)
    in_macro_now := true
    active_macro_name := "04:50-05:10"
else if f_check_macro(350, 370, mac_0550)
    in_macro_now := true
    active_macro_name := "05:50-06:10"
else if f_check_macro(410, 430, mac_0650)
    in_macro_now := true
    active_macro_name := "06:50-07:10"
else if f_check_macro(470, 490, mac_0750)
    in_macro_now := true
    active_macro_name := "07:50-08:10"
else if f_check_macro(530, 550, mac_0850)
    in_macro_now := true
    active_macro_name := "08:50-09:10"
else if f_check_macro(590, 610, mac_0950)
    in_macro_now := true
    active_macro_name := "09:50-10:10"
else if f_check_macro(650, 670, mac_1050)
    in_macro_now := true
    active_macro_name := "10:50-11:10"
else if f_check_macro(710, 730, mac_1150)
    in_macro_now := true
    active_macro_name := "11:50-12:10"
else if f_check_macro(770, 790, mac_1250)
    in_macro_now := true
    active_macro_name := "12:50-13:10"
else if f_check_macro(830, 850, mac_1350)
    in_macro_now := true
    active_macro_name := "13:50-14:10"
else if f_check_macro(890, 910, mac_1450)
    in_macro_now := true
    active_macro_name := "14:50-15:10"
else if f_check_macro(915, 945, mac_1515)
    in_macro_now := true
    active_macro_name := "15:15-15:45"
else if f_check_macro(950, 970, mac_1550)
    in_macro_now := true
    active_macro_name := "15:50-16:10"
else if f_check_macro(1010, 1030, mac_1650)
    in_macro_now := true
    active_macro_name := "16:50-17:10"
else if f_check_macro(1070, 1090, mac_1750)
    in_macro_now := true
    active_macro_name := "17:50-18:10"
else if f_check_macro(1130, 1150, mac_1850)
    in_macro_now := true
    active_macro_name := "18:50-19:10"
else if f_check_macro(1190, 1210, mac_1950)
    in_macro_now := true
    active_macro_name := "19:50-20:10"
else if f_check_macro(1250, 1270, mac_2050)
    in_macro_now := true
    active_macro_name := "20:50-21:10"
else if f_check_macro(1310, 1330, mac_2150)
    in_macro_now := true
    active_macro_name := "21:50-22:10"
else if f_check_macro(1370, 1390, mac_2250)
    in_macro_now := true
    active_macro_name := "22:50-23:10"
else if f_check_macro(1430, 10, mac_2350)
    in_macro_now := true
    active_macro_name := "23:50-00:10"

// A new window also starts when two enabled windows sit on consecutive bars (e.g. 14:50–15:10 then 15:15–15:45 on 15m)
bool macro_changed      = in_macro_now and in_macro_now[1] and active_macro_name != active_macro_name[1]
bool just_entered_macro = (in_macro_now and not in_macro_now[1]) or macro_changed
bool just_exited_macro  = not in_macro_now and in_macro_now[1]

// Macro Visuals State & Ring Buffer Management
var line[]  macro_lines_history  = array.new_line(0)
var label[] macro_labels_history = array.new_label(0)
const int   MAX_MACRO_HISTORY    = 60

f_prune_macro_history() =>
    while array.size(macro_lines_history) > (MAX_MACRO_HISTORY * 3)
        line old_l = array.shift(macro_lines_history)
        if not na(old_l)
            line.delete(old_l)
    while array.size(macro_labels_history) > MAX_MACRO_HISTORY
        label old_lbl = array.shift(macro_labels_history)
        if not na(old_lbl)
            label.delete(old_lbl)

var int   macro_start_bar = na
var float macro_high_val  = na
var float macro_low_val   = na
var line  macro_top_line  = na
var line  macro_left_leg  = na
var line  macro_right_leg = na
var label macro_lbl       = na

// Scaled leg length using user setting mac_line_len (relative to price)
float cur_price = not na(close) ? close : 20000.0
float scaled_leg_len = math.max(cur_price * mac_line_len, syminfo.mintick * 4)

if just_entered_macro
    macro_start_bar := bar_index
    macro_high_val  := high
    macro_low_val   := low
    float bg_top = macro_high_val
    float top_y  = bg_top + scaled_leg_len
    
    // 1. Top horizontal line
    macro_top_line := line.new(bar_index, top_y, bar_index, top_y, color=mac_line_col, style=line.style_solid)
    // 2. Left downward vertical leg
    macro_left_leg := line.new(bar_index, top_y, bar_index, top_y - scaled_leg_len, color=mac_line_col, style=line.style_solid)
    // 3. Right downward vertical leg
    macro_right_leg := line.new(bar_index, top_y, bar_index, top_y - scaled_leg_len, color=mac_line_col, style=line.style_solid)
    // 4. Centered speech bubble label with icon
    bool is_high_prob = active_macro_name == "08:50-09:10" or active_macro_name == "12:50-13:10" or active_macro_name == "15:15-15:45"
    string macro_icon = is_high_prob ? " 💰" : ""
    macro_lbl := label.new(bar_index, top_y, text=active_macro_name + macro_icon, color=color.new(mac_lbl_bg, 15), textcolor=mac_line_col, style=label.style_label_down, size=lbl_sz)
    
    array.push(macro_lines_history, macro_top_line)
    array.push(macro_lines_history, macro_left_leg)
    array.push(macro_lines_history, macro_right_leg)
    array.push(macro_labels_history, macro_lbl)
    f_prune_macro_history()

if in_macro_now and not just_entered_macro
    macro_high_val := math.max(macro_high_val, high)
    macro_low_val  := math.min(macro_low_val, low)
    float bg_top = macro_high_val
    float top_y  = bg_top + scaled_leg_len
    
    if not na(macro_top_line)
        line.set_y1(macro_top_line, top_y)
        line.set_y2(macro_top_line, top_y)
        line.set_x2(macro_top_line, bar_index)
        
    if not na(macro_left_leg)
        line.set_y1(macro_left_leg, top_y)
        line.set_y2(macro_left_leg, top_y - scaled_leg_len)
        
    if not na(macro_right_leg)
        line.set_xy1(macro_right_leg, bar_index, top_y)
        line.set_xy2(macro_right_leg, bar_index, top_y - scaled_leg_len)
        
    if not na(macro_lbl) and not na(macro_start_bar)
        label.set_xy(macro_lbl, math.round((macro_start_bar + bar_index) / 2), top_y)

if just_exited_macro
    macro_start_bar := na
    macro_top_line  := na
    macro_left_leg  := na
    macro_right_leg := na
    macro_lbl       := na

// =============================================================================
// 3. FVG & iFVG ENGINE (STATIC BOXES, ZERO DYNAMIC STRETCHING)
// =============================================================================

type FVGZone
    box   zone_box
    label zone_label
    float top
    float bottom
    int   direction   // +1 Bullish (demand), -1 Bearish (supply)
    int   start_bar
    bool  is_inverted
    bool  mitigated

var FVGZone[] fvg_array  = array.new<FVGZone>(0)
var FVGZone[] ifvg_array = array.new<FVGZone>(0)

const int MAX_FVG_CAPACITY = 100  // drawn FVG / iFVG boxes kept on chart
const int MAX_FVG_TRACKED  = 300  // FVGs monitored for inversion

// Tracking buffer only: every FVG is tracked for inversion, so pruning it must not erase drawn boxes
f_prune_active_fvg(int max_count) =>
    while array.size(fvg_array) > max_count
        array.shift(fvg_array)

// Drawn FVG boxes/labels are retained independently of the tracking buffer
var box[]   fvg_drawn_boxes  = array.new_box(0)
var label[] fvg_drawn_labels = array.new_label(0)

f_register_fvg_drawing(box b, label l) =>
    array.push(fvg_drawn_boxes, b)
    array.push(fvg_drawn_labels, l)
    while array.size(fvg_drawn_boxes) > MAX_FVG_CAPACITY
        box.delete(array.shift(fvg_drawn_boxes))
        label old_l = array.shift(fvg_drawn_labels)
        if not na(old_l)
            label.delete(old_l)

f_prune_active_ifvg(int max_count) =>
    while array.size(ifvg_array) > max_count
        FVGZone old_item = array.shift(ifvg_array)
        if not na(old_item.zone_box)
            box.delete(old_item.zone_box)
        if not na(old_item.zone_label)
            label.delete(old_item.zone_label)

float min_fvg_pts  = fvg_size_unit == "Ticks" ? min_fvg_size * syminfo.mintick : min_fvg_size
float min_ifvg_pts = fvg_size_unit == "Ticks" ? min_ifvg_size * syminfo.mintick : min_ifvg_size

bool bull_ifvg_formed = false
bool bear_ifvg_formed = false

if barstate.isconfirmed
    bool is_bull_fvg = (close[1] > open[1]) and (low > high[2]) and ((low - high[2]) >= min_fvg_pts)
    bool is_bear_fvg = (close[1] < open[1]) and (high < low[2]) and ((low[2] - high) >= min_fvg_pts)
    
    // Macro time filter constraint for creation (checked across gap formation window)
    bool valid_fvg_time = not fvg_macro_only or in_macro_now[1]
    
    // FVGs are always tracked so any gap can later invert; the macro filter only gates drawing
    bool draw_fvg = show_fvg and valid_fvg_time

    if (show_fvg or show_ifvg) and bar_index > 3
        if is_bull_fvg
            float top_p   = low
            float bot_p   = high[2]
            int   left_b  = bar_index - 1
            int   right_b = bar_index + fvg_extend
            
            box b_fvg = na
            label lbl_fvg = na
            if draw_fvg
                b_fvg := box.new(left = left_b, top = top_p, right = right_b, bottom = bot_p,
                                 xloc = xloc.bar_index,
                                 bgcolor = fvg_bg ? col_bull_fvg : color.new(color.white, 100),
                                 border_color = fvg_borders ? color.new(col_bull_fvg, 0) : color.new(color.white, 100),
                                 border_width = fvg_borders ? 1 : 0)
                if not fvg_no_labels
                    lbl_fvg := label.new(x = right_b, y = (top_p + bot_p) / 2.0, text = "FVG",
                                         xloc = xloc.bar_index, yloc = yloc.price,
                                         color = color.new(color.white, 100), textcolor = col_bull_fvg,
                                         style = label.style_none, size = size.tiny)
            
            if draw_fvg
                f_register_fvg_drawing(b_fvg, lbl_fvg)
            FVGZone new_fvg = FVGZone.new(b_fvg, lbl_fvg, top_p, bot_p, 1, left_b, false, false)
            array.push(fvg_array, new_fvg)
            f_prune_active_fvg(MAX_FVG_TRACKED)
            
        if is_bear_fvg
            float top_p   = low[2]
            float bot_p   = high
            int   left_b  = bar_index - 1
            int   right_b = bar_index + fvg_extend
            
            box b_fvg = na
            label lbl_fvg = na
            if draw_fvg
                b_fvg := box.new(left = left_b, top = top_p, right = right_b, bottom = bot_p,
                                 xloc = xloc.bar_index,
                                 bgcolor = fvg_bg ? col_bear_fvg : color.new(color.white, 100),
                                 border_color = fvg_borders ? color.new(col_bear_fvg, 0) : color.new(color.white, 100),
                                 border_width = fvg_borders ? 1 : 0)
                if not fvg_no_labels
                    lbl_fvg := label.new(x = right_b, y = (top_p + bot_p) / 2.0, text = "FVG",
                                         xloc = xloc.bar_index, yloc = yloc.price,
                                         color = color.new(color.white, 100), textcolor = col_bear_fvg,
                                         style = label.style_none, size = size.tiny)
            
            if draw_fvg
                f_register_fvg_drawing(b_fvg, lbl_fvg)
            FVGZone new_fvg = FVGZone.new(b_fvg, lbl_fvg, top_p, bot_p, -1, left_b, false, false)
            array.push(fvg_array, new_fvg)
            f_prune_active_fvg(MAX_FVG_TRACKED)

    // Evaluate Mitigation & Inversion
    if array.size(fvg_array) > 0
        for i = array.size(fvg_array) - 1 to 0
            FVGZone item = array.get(fvg_array, i)
            if not item.is_inverted
                bool is_past_creation = bar_index > (item.start_bar + 1)
                
                // 1. Check for Inversion (Close beyond the gap)
                bool inverted = false
                if is_past_creation
                    if item.direction == 1 and close < item.bottom
                        inverted := true
                    else if item.direction == -1 and close > item.top
                        inverted := true

                if inverted
                    item.is_inverted := true
                    
                    bool valid_ifvg_time = not ifvg_macro_only or in_macro_now or in_macro_now[1]
                    if show_ifvg and valid_ifvg_time and (math.abs(item.top - item.bottom) >= min_ifvg_pts)
                        int ifvg_right = bar_index + ifvg_extend
                        box b_ifvg = box.new(left = bar_index, top = item.top, right = ifvg_right, bottom = item.bottom,
                                             xloc = xloc.bar_index,
                                             bgcolor = ifvg_bg ? (item.direction == 1 ? col_bear_ifvg : col_bull_ifvg) : color.new(color.white, 100),
                                             border_color = ifvg_borders ? (item.direction == 1 ? col_bear_ifvg : col_bull_ifvg) : color.new(color.white, 100),
                                             border_width = ifvg_borders ? 1 : 0)
                        label lbl_ifvg = na
                        if not ifvg_no_labels
                            lbl_ifvg := label.new(x = ifvg_right, y = (item.top + item.bottom) / 2.0, text = item.direction == 1 ? "-iFVG" : "+iFVG",
                                                  xloc = xloc.bar_index, yloc = yloc.price,
                                                  color = color.new(color.white, 100), textcolor = item.direction == 1 ? col_bear_ifvg : col_bull_ifvg,
                                                  style = label.style_none, size = size.tiny)
                        if item.direction == 1
                            bear_ifvg_formed := true
                        else
                            bull_ifvg_formed := true
                        FVGZone new_inv = FVGZone.new(b_ifvg, lbl_ifvg, item.top, item.bottom, item.direction == 1 ? -1 : 1, bar_index, true, false)
                        array.push(ifvg_array, new_inv)
                        f_prune_active_ifvg(MAX_FVG_CAPACITY)
                    array.remove(fvg_array, i)
                else
                    // 2. Check for Mitigation (Touch)
                    if not item.mitigated
                        if is_past_creation and ((item.direction == 1 and low <= item.top) or (item.direction == -1 and high >= item.bottom))
                            item.mitigated := true

    // Check Mitigation of iFVGs
    if array.size(ifvg_array) > 0
        for i = array.size(ifvg_array) - 1 to 0
            FVGZone item = array.get(ifvg_array, i)
            if not item.mitigated
                bool is_past_creation = bar_index > item.start_bar
                if is_past_creation and ((item.direction == -1 and close > item.top) or (item.direction == 1 and close < item.bottom))
                    item.mitigated := true
                    array.remove(ifvg_array, i)

// =============================================================================
// 4. LIQUIDITY LEVELS & SWEEP MARKERS (ARROW RESTORATION)
// =============================================================================

type LiquidityLvl
    float price
    int   start_bar
    int   direction // -1 = Bearish (Highs / Resistance), 1 = Bullish (Lows / Support)
    bool  swept
    line  lvl_line
    
var LiquidityLvl[] active_liq = array.new<LiquidityLvl>()
var LiquidityLvl[] swept_liq  = array.new<LiquidityLvl>()

// Mode mapping matching Herman original settings (Conservative = Swing 20)
int swing_len = liq_mode == "Aggressive" ? 5 : liq_mode == "Balanced" ? 10 : 20

float pivot_h = ta.pivothigh(high, swing_len, swing_len)
float pivot_l = ta.pivotlow(low, swing_len, swing_len)

f_cleanup_liq() =>
    while array.size(active_liq) > max_liq_lines
        LiquidityLvl old_item = array.shift(active_liq)
        if not na(old_item.lvl_line)
            line.delete(old_item.lvl_line)
    while array.size(swept_liq) > max_swept_lines
        LiquidityLvl old_item = array.shift(swept_liq)
        if not na(old_item.lvl_line)
            line.delete(old_item.lvl_line)

// Sweep Event Variables for Plotting Arrows
var label[] sweep_labels_history = array.new_label(0)
const int   MAX_SWEEP_LABELS     = 100

f_prune_sweep_labels() =>
    while array.size(sweep_labels_history) > MAX_SWEEP_LABELS
        label old_lbl = array.shift(sweep_labels_history)
        if not na(old_lbl)
            label.delete(old_lbl)

bool bull_sweep_event = false
bool bear_sweep_event = false

if en_liq and barstate.isconfirmed
    // 1. Detect new Bearish Liquidity (Resistance Above Highs) -> Red
    if not na(pivot_h)
        line l_h = line.new(x1=bar_index - swing_len, y1=pivot_h, x2=bar_index, y2=pivot_h, color=col_bear_liq, style=line.style_solid)
        array.push(active_liq, LiquidityLvl.new(pivot_h, bar_index - swing_len, -1, false, l_h))
        f_cleanup_liq()
        
    // 2. Detect new Bullish Liquidity (Support Below Lows) -> Green
    if not na(pivot_l)
        line l_l = line.new(x1=bar_index - swing_len, y1=pivot_l, x2=bar_index, y2=pivot_l, color=col_bull_liq, style=line.style_solid)
        array.push(active_liq, LiquidityLvl.new(pivot_l, bar_index - swing_len, 1, false, l_l))
        f_cleanup_liq()
        
    // 3. Process Active and Swept Liquidity Lines
    if array.size(active_liq) > 0
        for i = array.size(active_liq) - 1 to 0
            LiquidityLvl item = array.get(active_liq, i)
            if not item.swept
                if liq_extend_current and not na(item.lvl_line)
                    line.set_x2(item.lvl_line, bar_index)
                
                // Liquidity is taken on any breach. A breach that closes back inside is a sweep (arrow);
                // a close through the level is a break, so the level is retired without a sweep marker.
                bool breached = item.direction == -1 ? high >= item.price : low <= item.price
                bool is_swept = breached and (item.direction == -1 ? close < item.price : close > item.price)
                
                if breached
                    item.swept := true
                    if not na(item.lvl_line)
                        line.set_style(item.lvl_line, line.style_dashed)
                        line.set_color(item.lvl_line, item.direction == -1 ? col_bear_swept : col_bull_swept)
                        line.set_x2(item.lvl_line, bar_index) // Lock at sweep bar
                    
                    if is_swept
                        if item.direction == -1
                            bear_sweep_event := true
                        else
                            bull_sweep_event := true

                    // Plot Directional Sweep Arrow (Matches Official Herman Visual Reference)
                    if show_sweep_markers and is_swept
                        if item.direction == -1
                            label lbl_swp_dn = label.new(x = bar_index, y = high, text = "↓",
                                                         xloc = xloc.bar_index, yloc = yloc.abovebar,
                                                         color = color.new(color.white, 100), textcolor = col_bear_sweep,
                                                         style = label.style_none, size = size.normal)
                            array.push(sweep_labels_history, lbl_swp_dn)
                        else
                            label lbl_swp_up = label.new(x = bar_index, y = low, text = "↑",
                                                         xloc = xloc.bar_index, yloc = yloc.belowbar,
                                                         color = color.new(color.white, 100), textcolor = col_bull_sweep,
                                                         style = label.style_none, size = size.normal)
                            array.push(sweep_labels_history, lbl_swp_up)
                        f_prune_sweep_labels()

                    // Transfer to swept array
                    array.push(swept_liq, item)
                    array.remove(active_liq, i)
                    f_cleanup_liq()

// =============================================================================
// 5. ALERTS
// =============================================================================

alertcondition(just_entered_macro, "Entered Macro Time Window", "Macro execution window started: {{ticker}} {{interval}}.")
alertcondition(just_exited_macro, "Exited Macro Time Window", "Macro execution window closed: {{ticker}} {{interval}}.")
alertcondition(bear_sweep_event, "Buy-side liquidity swept", "Swing-high liquidity swept and reclaimed on {{ticker}} {{interval}}.")
alertcondition(bull_sweep_event, "Sell-side liquidity swept", "Swing-low liquidity swept and reclaimed on {{ticker}} {{interval}}.")
alertcondition(bull_ifvg_formed, "Bullish iFVG formed", "Bearish FVG inverted to bullish iFVG on {{ticker}} {{interval}}.")
alertcondition(bear_ifvg_formed, "Bearish iFVG formed", "Bullish FVG inverted to bearish iFVG on {{ticker}} {{interval}}.")
